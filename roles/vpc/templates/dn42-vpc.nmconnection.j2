# {{ ansible_managed }}
# {{ inventory_hostname }}: provider VPC NIC. DHCP gives the private address; the
# default route stays on the public NIC; the dn42 addresses make this router the
# gateway for dn42 traffic of the hosts behind it.
[connection]
id=dn42-vpc
type={{ 'vlan' if vlan_id | string | length > 0 else 'ethernet' }}
interface-name={{ vpc_iface }}
autoconnect=true

{% if vlan_id | string | length > 0 %}
[vlan]
id={{ vlan_id }}
parent={{ vlan_parent }}
{% else %}
[ethernet]
{% endif %}

[ipv4]
{% if vpc_static %}
{# our own dn42 addressing (always the case on a VLAN, which has no DHCP server) #}
{% if vpc_dn42_net4 %}
method=manual
address1={{ vpc_gw4 }}/{{ vpc_dn42_net4.split('/')[1] }}
{% else %}
method=disabled
{% endif %}
{% else %}
method=auto
never-default=true
ignore-auto-dns=true
{% if vpc_dn42_net4 %}
address1={{ vpc_gw4 }}/{{ vpc_dn42_net4.split('/')[1] }}
{% endif %}
{% endif %}

[ipv6]
method=manual
address1={{ vpc_dn42_net6 | regex_replace('::/64$', '::1/64') }}
{% if edge_bgp_enabled | bool and edge_neighbor6 | length > 0 %}
address2={{ edge_vlan_gw6 }}/64
{% endif %}
never-default=true
