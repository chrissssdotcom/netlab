# {{ ansible_managed }}
# Router: forward v4 + v6
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
net.ipv6.conf.default.forwarding = 1

# Asymmetric paths are normal across a mesh: no strict reverse-path filtering
net.ipv4.conf.all.rp_filter = 0
net.ipv4.conf.default.rp_filter = 0

# Never let redirects change routing
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0

# Forwarding disables RA processing; keep the provider's IPv6 default route
net.ipv6.conf.{{ public_interface }}.accept_ra = 2
